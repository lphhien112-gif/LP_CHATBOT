# ─────────────────────────────────────────────────────────────────────────────
# LP_CHATBOT — mẫu cấu hình môi trường.
# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit file .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (tương thích OpenAI; có thể trỏ tới proxy OpenAI-compatible) ──────────
# API key. Chấp nhận một trong hai tên: OPENAI_API_KEY hoặc API_KEY.
OPENAI_API_KEY="sk-your-key-here"
# Base URL của endpoint LLM. Để trống = dùng api.openai.com mặc định.
# Khi dùng proxy, đặt URL proxy (kết thúc bằng /v1). Chấp nhận: OPENAI_BASE_URL hoặc BASE_URL.
# OPENAI_BASE_URL="https://your-proxy.example.com/v1"
# Tên model. Chấp nhận: MODEL_NAME hoặc OPENAI_MODEL.
MODEL_NAME="gpt-4o-mini"
# Thời gian chờ tối đa mỗi lần gọi LLM (giây).
LLM_TIMEOUT_SECONDS=15.0

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
DEBUG=True

# ── Redis / Session ──────────────────────────────────────────────────────────
# Nếu không có Redis, ứng dụng tự dùng RAM fallback (chỉ nên dùng cho dev).
# Khởi động Redis nhanh: docker run -p 6379:6379 redis
REDIS_URL=redis://localhost:6379/0
